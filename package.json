{
  "name": "sting",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "node scripts/replace-env.js && ng build --configuration production",
    "configure-env": "node scripts/replace-env.js",
    "setup:firebase": "bash scripts/setup-firebase.sh",
    "deploy:firebase": "npm run build:prod && firebase deploy --only hosting:sting --project sting-protopipe",
    "deploy:shire": "npm run deploy:firebase",
    "deploy:shire:app": "STING_SHIRE_URL=https://shire.droppin.shop STING_MICRO_URL=https://droppin.shop STING_APP_NAME=SearchClimber.io npm run build:prod && firebase deploy --only hosting:sting --project sting-protopipe",
    "deploy:searchclimber": "STING_SHIRE_URL=https://api.searchclimber.io STING_MICRO_URL=https://droppin.shop STING_APP_NAME=SearchClimber.io npm run build:prod && firebase deploy --only hosting:sting --project sting-protopipe",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "validate:build-book": "npx vitest run src/app/features/protopipe/build-book/validation/build-book-baseline-gate.spec.ts src/app/features/protopipe/build-book/validation/build-book-baseline-routing.spec.ts src/app/features/protopipe/site-design/site-design.spec.ts src/app/features/protopipe/site-design/site-theme-palette.spec.ts src/app/features/protopipe/site-design/site-theme-google-fonts.spec.ts src/app/features/protopipe/site-design/site-theme-fonts.spec.ts src/app/features/protopipe/site-design/site-theme-font-pairings.spec.ts",
    "architect:graph": "detective"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/bitter": "^5.2.10",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/crimson-pro": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/figtree": "^5.2.10",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@fontsource/lora": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/nunito-sans": "^5.2.7",
    "@fontsource/open-sans": "^5.2.7",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@fontsource/rubik": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.9",
    "@fontsource/source-serif-4": "^5.2.9",
    "@fontsource/work-sans": "^5.2.8",
    "@hive/contracts": "file:../hive-contracts",
    "@primeuix/themes": "^2.0.3",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/leaflet": "^1.9.21",
    "jspdf": "1.5.3",
    "leaflet": "^1.9.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tiptap-markdown": "^0.8.10",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@softarc/detective": "^2.0.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
