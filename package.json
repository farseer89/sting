{
  "name": "sting",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "node scripts/replace-env.js && ng build --configuration production",
    "configure-env": "node scripts/replace-env.js",
    "setup:firebase": "bash scripts/setup-firebase.sh",
    "deploy:firebase": "npm run build:prod && firebase deploy --only hosting:sting --project sting-protopipe",
    "deploy:shire": "STING_SHIRE_URL=https://shire.droppin.shop STING_MICRO_URL=https://droppin.shop STING_APP_NAME=SearchClimber.ai npm run deploy:firebase",
    "deploy:shire:app": "STING_SHIRE_URL=https://shire.droppin.shop STING_MICRO_URL=https://droppin.shop STING_APP_NAME=SearchClimber.ai firebase deploy --only hosting:sting --project sting-protopipe",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "architect:graph": "detective"
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/animations": "^21.2.13",
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@hive/contracts": "file:../hive-contracts",
    "@primeuix/themes": "^2.0.3",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/leaflet": "^1.9.21",
    "jspdf": "1.5.3",
    "leaflet": "^1.9.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "rxjs": "~7.8.0",
    "tiptap-markdown": "^0.8.10",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@softarc/detective": "^2.0.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
